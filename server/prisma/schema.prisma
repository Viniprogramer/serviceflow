datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TECH
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TECH)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id          String      @id @default(uuid())
  name        String
  contact     String
  phone       String
  equipments  Equipment[]
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
}

model Technician {
  id          String      @id @default(uuid())
  name        String
  specialty   String
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
}

model ServiceItem {
  id          String      @id @default(uuid())
  title       String
  basePrice   Float
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
}

model Equipment {
  id           String      @id @default(uuid())
  clientId     String
  name         String
  serialNumber String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]
  createdAt    DateTime    @default(now())
}

model WorkOrder {
  id            String          @id @default(uuid())
  clientId      String
  technicianId  String
  serviceId     String
  equipmentId   String
  status        WorkOrderStatus @default(OPEN)
  description   String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  technician    Technician      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  service       ServiceItem     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  equipment     Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  photos        WorkOrderPhoto[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model WorkOrderPhoto {
  id           String    @id @default(uuid())
  workOrderId  String
  fileName     String
  description  String    @default("")
  mimeType     String?
  dataBase64   String?
  uploadedAt   DateTime  @default(now())
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}
